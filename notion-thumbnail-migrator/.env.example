NOTION_TOKEN=secret_xxx
NOTION_DATABASE_ID=4f8a9f94c3474654b521304da069999c
THUMBNAIL_PROPERTY_NAME=Thumbnail
NOTION_VERSION=2025-09-03
DRY_RUN=true
FORCE_OVERWRITE=false
# 샘플 1개만 테스트할 때 사용
ONLY_PAGE_ID=
# 전체 중 일부만 실행하고 싶을 때 (0이면 제한 없음)
MAX_ITEMS=0
# true면 Thumbnail 업데이트 대신 본문 첫 이미지를 로컬에 저장
DOWNLOAD_ONLY=false
# 다운로드 저장 폴더(작업 디렉터리 기준)
DOWNLOAD_DIR=downloads
# true면 다운로드 + Cloudinary 업로드 + Notion URL 속성 업데이트
DOWNLOAD_AND_APPLY_URL=false
THUMBNAIL_URL_PROPERTY_NAME=Thumbnail_URL
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=notion-thumb
